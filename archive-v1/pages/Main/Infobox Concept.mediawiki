| title = Infobox Concept: Template for Concept Documentation
| description = Standardized infobox template for documenting concepts in BITwiki with validation, TemplateStyles CSS isolation, and parser function validation.
| type = template
| author = BITCORE
| created = 2026-02-12
| version = 3.established
| epistemic_status = Established
| confidence = established
