{
  "project": "BITwiki V2 public corpus",
  "site": "https://bitwiki.org",
  "repository": "bitwikiorg/wiki-content",
  "format": "MediaWiki wikitext + namespace-native source (Lua/CSS/JS where required)",
  "visibility": "public-only",
  "status": "source-grounded V2",
  "source_policy": "source-first; preserve authored language, implementation reality, revision history and provenance; distinguish documented design from deployed objects",
  "namespace_paths": {
    "Main": "Main/",
    "BITwiki": "BITwiki/",
    "Template": "Template/",
    "Property": "Property/",
    "Category": "Category/",
    "Concept": "Concept/",
    "Module": "Module/",
    "MediaWiki": "MediaWiki/",
    "Help": "Help/",
    "smw/schema": "SMWSchema/"
  },
  "title_projection_paths": {
    "Portal": "Portal/"
  },
  "mediawiki_substrate": {
    "authority": "live/captured MediaWiki siteinfo, not repository folder names",
    "namespace_info": "https://bitwiki.org/Special:NamespaceInfo",
    "version_info": "https://bitwiki.org/Special:Version",
    "source_control_mappings": {
      "Main": {
        "path": "Main/",
        "kind": "namespace",
        "content_model": "wikitext"
      },
      "BITwiki": {
        "path": "BITwiki/",
        "kind": "namespace",
        "content_model": "wikitext",
        "canonical_name": "Project"
      },
      "Template": {
        "path": "Template/",
        "kind": "namespace",
        "content_model": "wikitext"
      },
      "Property": {
        "path": "Property/",
        "kind": "namespace",
        "content_model": "wikitext",
        "extension": "SemanticMediaWiki"
      },
      "Category": {
        "path": "Category/",
        "kind": "namespace",
        "content_model": "wikitext"
      },
      "Concept": {
        "path": "Concept/",
        "kind": "namespace",
        "content_model": "wikitext",
        "extension": "SemanticMediaWiki"
      },
      "smw/schema": {
        "path": "SMWSchema/",
        "kind": "namespace",
        "content_model": "smw/schema",
        "extension": "SemanticMediaWiki",
        "filename_encoding": "URL-encode colon in namespace-local title"
      },
      "Module": {
        "path": "Module/",
        "kind": "namespace",
        "content_model": "Scribunto/Lua",
        "extension": "Scribunto"
      },
      "MediaWiki": {
        "path": "MediaWiki/",
        "kind": "namespace",
        "content_model": "page-specific (wikitext/CSS/JS)"
      },
      "Help": {
        "path": "Help/",
        "kind": "namespace",
        "content_model": "wikitext"
      },
      "Portal": {
        "path": "Portal/",
        "kind": "title projection",
        "content_model": "wikitext",
        "namespace_configured_in_snapshot": false
      }
    },
    "runtime_namespaces_not_deployed_from_this_corpus": [
      "Talk",
      "User",
      "User talk",
      "BITwiki talk",
      "File",
      "File talk",
      "MediaWiki talk",
      "Template talk",
      "Help talk",
      "Category talk",
      "Property talk",
      "Concept talk",
      "smw/schema talk",
      "Module talk"
    ],
    "capabilities_in_active_use": [
      "Semantic MediaWiki properties",
      "Semantic MediaWiki #ask",
      "MediaWiki templates/transclusion",
      "Scribunto compiler/type validation"
    ],
    "capabilities_installed_but_use_case_gated": [
      "SMW subobjects",
      "additional SMW Concepts",
      "Network graph views",
      "FacetedSearch/Drilldown",
      "Cargo operational workflows"
    ],
    "capabilities_not_assumed_or_requires_deployment": [
      "native structured SMW access from Lua via SemanticScribunto"
    ],
    "substrate_audit": {
      "generator": "scripts/audit_substrate.py",
      "output": "v2-substrate-audit.json",
      "distribution": "CI artifact; untracked"
    },
    "deployment_contract": {
      "scope_authority": "mediawiki_substrate.source_control_mappings",
      "planner": "scripts/deployment_plan.py",
      "plan_output": "v2-deployment-plan.json",
      "plan_distribution": "CI artifact; untracked",
      "recursive_discovery_required": true,
      "executor": "scripts/deploy_mediawiki.py",
      "executor_default": "dry-run; explicit --execute required",
      "existing_page_policy": "unchanged pages skip; differing pages require --overwrite-existing; content-model mismatches are refused",
      "concurrency_policy": "new pages use create-only semantics; existing-page writes are anchored to the queried base revision",
      "runtime_checkpoints": {}
    }
  },
  "programmable_knowledge_substrate": {
    "architecture_page": "BITwiki/Programmable knowledge substrate.mediawiki",
    "lua_standard": "BITwiki/Lua architecture.mediawiki",
    "authoring_syntax": "MediaWiki wikitext and Templates",
    "structured_state": [
      "Semantic MediaWiki",
      "Cargo"
    ],
    "compiler_runtime": "Scribunto/Lua",
    "compiler_module_family": "Module:BITwiki/*",
    "public_validation_wrapper": "Module:Structure",
    "runtime_schema_authority": "bitwiki-runtime-schema.json",
    "runtime_schema_projection": "Module/BITwiki/Data/Schema.lua",
    "runtime_schema_audit": "scripts/audit_runtime_schema.py",
    "compiler_passes": [
      "normalize",
      "type-check",
      "resolve wiki-resident state",
      "derive bounded explicit rules",
      "project",
      "diagnose"
    ],
    "inference_default": "derived display/diagnostic only; no hidden persistent assertions",
    "transport_boundary": "Scribunto is not the network/API bridge between MediaWiki and BIThub/Discourse"
  },
  "ecosystem_interface": {
    "canonical_knowledge_plane": "BITwiki / MediaWiki",
    "interaction_workflow_plane": "BIThub / Discourse",
    "cognition_orchestration_plane": "BITCORE / agents and workflows",
    "integration_transport": "explicit authenticated MediaWiki/Discourse APIs, plugins, services, or agents",
    "authority_invariant": "BIThub may project and propose against canonical BITwiki state but does not become a competing semantic source of truth",
    "round_trip_invariant": "cross-system writes preserve actor/process identity, provenance, review state, and the target MediaWiki/SMW/Cargo contract"
  },
  "v2_validation": {
    "generator": "scripts/validate_v2.py",
    "output": "v2-validation.json",
    "distribution": "CI artifact; untracked",
    "controlled_domains_required": 13,
    "domain_exemplar_coverage_required": true,
    "semantic_identity_validation": true,
    "knowledge_object_fields_required": [],
    "knowledge_object_fields_optional": [
      "entity_type",
      "domain",
      "status",
      "provenance"
    ],
    "unregistered_type_domain_policy": "review-only; not a corpus admission failure",
    "invalid_explicit_epistemic_status_policy": "error",
    "runtime_schema_audit": {
      "generator": "scripts/audit_runtime_schema.py",
      "output": "v2-runtime-schema-audit.json",
      "distribution": "CI artifact; untracked",
      "invariant": "bitwiki-runtime-schema.json, Module:BITwiki/Data/Schema, and Python validation vocabularies must agree"
    }
  },
  "mainspace_audit": {
    "generator": "scripts/audit_mainspace.py",
    "output": "v2-mainspace-audit.json",
    "distribution": "CI artifact; untracked",
    "purpose": "separate redirects, exemplars, knowledge objects, subpages and short-content review candidates without treating size as quality"
  },
  "navigation": {
    "recursive_portal_title_projections": true,
    "polyhierarchical_portal_navigation": true,
    "canonical_focused_portal_titles": [
      "Portal:Bioinformatics",
      "Portal:Python"
    ],
    "legacy_slash_paths_are_redirects": true,
    "portal_hierarchy_is_ontology": false,
    "portal_namespace_configured_in_snapshot": false,
    "depth_localization": [
      "Simple orientation",
      "Core understanding",
      "Technical depth",
      "Frontier / research"
    ]
  },
  "research_surfaces": {
    "references": "BITwiki/Research references.mediawiki",
    "comparative_wikis": "BITwiki/Comparative wiki research register.mediawiki",
    "navigation_coverage": "BITwiki/Navigation and coverage research.mediawiki",
    "sensitive_topics": "BITwiki/Sensitive topic scope research.mediawiki"
  },
  "operational_workflows": {
    "knowledge_requests": {
      "records": "ops/knowledge-requests.json",
      "publish_to_mediawiki": false,
      "repository_visibility": "public (not a private operational store)",
      "audit": "scripts/audit_workflow.py",
      "audit_output": "v2-workflow-audit.json",
      "audit_distribution": "CI artifact; untracked",
      "active_statuses": [
        "requested",
        "researching",
        "drafting",
        "review"
      ],
      "terminal_statuses": [
        "satisfied",
        "declined"
      ],
      "invariant": "an active request must not already exist as a canonical Main page"
    }
  },
  "evidence_policy": {
    "automation_repository_permissions": "read-only for validation workflows",
    "generated_reports_tracked": false,
    "distribution": "GitHub Actions artifacts",
    "reason": "current-state validation and verification are commit/run-specific evidence, not canonical mutable repository source",
    "transient_reports": [
      "v2-validation.json",
      "v2-runtime-schema-audit.json",
      "v2-substrate-audit.json",
      "v2-workflow-audit.json",
      "v2-mainspace-audit.json",
      "v2-deployment-plan.json",
      "v2-corpus-inventory.json"
    ]
  },
  "canonicalization_loop": [
    "recover source",
    "preserve raw signal",
    "compare revisions",
    "distinguish design intent from implementation",
    "research and cross-check",
    "distill redundancy",
    "revise",
    "verify",
    "canonicalize",
    "transclude and relate",
    "publish"
  ]
}
