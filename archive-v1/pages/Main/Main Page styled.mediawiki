{{Template:BITwiki_header_element}}

</br>

<div style="max-width:1280px; margin:0 auto; padding:0 24px;">

<!-- ====== TOP GRID ====== -->
<div style="display:grid; grid-template-columns:2fr 1fr; gap:24px; align-items:start;">

  <!-- ===== LEFT MAIN COLUMN ===== -->
  <div style="display:flex; flex-direction:column; gap:18px;">

    <!-- Live Stats + What Makes Us Different SIDE-BY-SIDE -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
      <div style="border:1px solid #dde4f8; background:#f8faff; border-radius:12px; padding:14px;">
        {{:Live_Stats_section}}
      </div>
      <div style="border:1px solid #e5e5e5; background:#ffffff; border-radius:12px; padding:14px;">
        {{:What_Makes_Us_Different_section}}
      </div>
    </div>

    <!-- Start Exploring -->
    <div style="border:1px solid #d6e6d6; background:#f9fff9; border-radius:12px; padding:14px;">
      {{:Start_Exploring_section}}
    </div>

    <!-- Featured Articles -->
    <div style="border:1px solid #ffe3ba; background:#fffaf3; border-radius:12px; padding:14px;">
      {{:Featured_Articles_section}}
    </div>
  </div>

  <!-- ===== RIGHT SIDEBAR ===== -->
  <div style="display:flex; flex-direction:column; gap:18px;">
    <div style="border:1px solid #dce4ff; background:linear-gradient(180deg,#f4f7ff,#edf2ff); border-radius:12px; padding:14px;">
      {{:Site_notice}}
    </div>
    <div style="border:1px solid #e0eaff; background:linear-gradient(180deg,#f7f9ff,#f1f5ff); border-radius:12px; padding:14px;">
      {{:Learn_More_section}}
    </div>
  </div>
</div>

<!-- Decorative transition -->
<div style="text-align:center; margin:24px 0 8px 0;">
  {{Template:BITwiki projects decorative circle}}
</div>

<!-- ===== EMERGENT PROPERTIES ===== -->
<hr style="margin:32px 0 20px 0; border:none; border-top:1px solid #dcdcdc;">
<div style="border:1px solid #e8e8e8; background:#ffffff; border-radius:12px; padding:16px;">
  {{:Emergent_Properties_section}}
</div>

<div style="text-align:center; margin:24px 0 8px 0;">
  {{Template:BITwiki implementations decorative circle}}
</div>

<!-- ===== PROJECTS ===== -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(380px,1fr)); gap:20px; margin-bottom:28px;">
  <div style="border:1px solid #d8f0d8; background:#f9fff9; border-radius:12px; padding:16px;">
    {{:Projects_section}}
  </div>
</div>

<div style="text-align:center; margin:24px 0 8px 0;">
  {{Template:BITwiki constructs decorative circle}}
</div>

<!-- ===== CONSTRUCTS + IMPLEMENTATIONS ===== -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(480px,1fr)); gap:20px; margin-bottom:32px;">
  <div style="border:1px solid #e6eaff; background:#fafbff; border-radius:12px; padding:16px;">
    {{:Constructs_section}}
  </div>
  <div style="border:1px solid #e4ffec; background:#fbfffb; border-radius:12px; padding:16px;">
    {{:Implementations_section}}
  </div>
</div>

<div style="text-align:center; margin:24px 0 8px 0;">
  {{Template:BITwiki simple decorative circle}}
</div>

<!-- ===== FOOTER ===== -->
<div style="border-top:1px solid #ddd; margin-top:32px; padding-top:12px; text-align:center;">
  {{Template:BITwiki footer}}
</div>

</div>
