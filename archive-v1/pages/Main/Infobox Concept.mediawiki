| ontology = entity_type: infobox-template
domain: concept-documentation
| workflow = state: Beta
}}

{{Documentation}}
[[Category:BITwiki Templates]]
[[Category:Infobox Templates]]



<templatestyles src="Template:Infobox_Concept/styles.css" />


{{#if: {{{name|}}}
| 
| <div class="infobox-concept error-box">Error: Missing required parameter name. [[Category:Infobox Concept missing name]]</div>
}}

{{#if: {{{definition|}}}
| 
| <div class="infobox-concept error-box">Error: Missing required parameter definition. [[Category:Infobox Concept missing definition]]</div>
}}

{{#if: {{{epistemic_status|}}}
| 
{{#switch: {{{epistemic_status}}}
| Hypothetical = 
| Emerging = 
| Established = 
| Verified = 
| Axiomatic = 
| #default = <div class="infobox-concept error-box">Error: Invalid epistemic_status. Must be: Hypothetical, Emerging, Established, Verified, or Axiomatic. [[Category:Infobox Concept invalid epistemic status]]</div>
}}
| <div class="infobox-concept error-box">Error: Missing required parameter epistemic_status. [[Category:Infobox Concept missing epistemic status]]</div>
}}

{{#if: {{{confidence_score|}}}
| 
{{#ifexpr: {{{confidence_score}}} >= 0 and {{{confidence_score}}} <= 1
| 
| <div class="infobox-concept error-box">Error: confidence_score must be between established and 1.0. [[Category:Infobox Concept invalid confidence]]</div>
}}
| <div class="infobox-concept error-box">Error: Missing required parameter confidence_score. [[Category:Infobox Concept missing confidence]]</div>
}}


<div class="infobox-concept">
<div class="infobox-header">Concept: {{{name|{{PAGENAME}}}}}</div>

{{#if: {{{image|}}}
| <div class="infobox-image">[[File:{{{image}}}|frameless|upright=1.0|{{#if: {{{caption|}}}|{{{caption}}}|Image of {{{name|{{PAGENAME}}}}}}}]]</div>
{{#if: {{{caption|}}}
| <div class="infobox-caption">{{{caption}}}</div>
}}
}}

<div class="infobox-section">
<div class="infobox-label">Definition</div>
<div class="infobox-value">{{{definition|Not provided}}}</div>
</div>

{{#if: {{{originator|}}}
| <div class="infobox-section">
<div class="infobox-label">Originator</div>
<div class="infobox-value">[[{{{originator}}}]]</div>
</div>
}}

{{#if: {{{origin_date|}}}
| <div class="infobox-section">
<div class="infobox-label">Origin Date</div>
<div class="infobox-value">{{{origin_date}}}</div>
</div>
}}

{{#if: {{{domain|}}}
| <div class="infobox-section">
<div class="infobox-label">Domain</div>
<div class="infobox-value">[[{{{domain}}}]]</div>
</div>
}}

{{#if: {{{related_concepts|}}}
| <div class="infobox-section">
<div class="infobox-label">Related Concepts</div>
<div class="infobox-value">{{{related_concepts}}}</div>
</div>
}}

{{#if: {{{implementations|}}}
| <div class="infobox-section">
<div class="infobox-label">Implementations</div>
<div class="infobox-value">{{{implementations}}}</div>
</div>
}}

<div class="infobox-section epistemic-section">
<div class="infobox-label">Epistemic Status</div>
<div class="infobox-value epistemic-{{#switch: {{{epistemic_status|Unknown}}
| Hypothetical = hypothetical
| Emerging = emerging
| Established = established
| Verified = verified
| Axiomatic = axiomatic
| #default = unknown
}}">{{{epistemic_status|Unknown}}}</div>
</div>

{{#if: {{{confidence_score|}}}
| <div class="infobox-section">
<div class="infobox-label">Confidence Score</div>
<div class="infobox-value">{{#expr: {{{confidence_score}}} * 100 round 0}}%</div>
</div>
}}

{{#if: {{{source_count|}}}
| <div class="infobox-section">
<div class="infobox-label">Source Count</div>
<div class="infobox-value">{{{source_count}}}</div>
</div>
}}

</div>



