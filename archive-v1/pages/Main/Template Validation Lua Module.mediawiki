== 5. Module:CommentValidator ==

=== 5.1 Comment Validation Module ===

```lua
-- Module:CommentValidator
-- Validates Template:Comment parameters
-- Dependencies: Module:ValidatorBase

local p = {}
local base = require("Module:ValidatorBase")

function p.validate(frame)
    local args = frame.args
    local errors = {}
    local smw_properties = {}
    
    -- Content is required
    if base.is_empty(args.content) then
        table.insert(errors, "Comment content is required")
    else
        smw_properties["Has comment content"] = args.content
    end
    
    -- Comment type validation
    if not base.is_empty(args.type) then
        local type_error = base.validate_comment_type(args.type)
        if type_error then
            table.insert(errors, type_error)
        else
            smw_properties["Has comment type"] = base.normalize_string(args.type)
        end
    else
        smw_properties["Has comment type"] = "Claim"  -- Default
    end
    
    -- Epistemic status validation
    if not base.is_empty(args.epistemic_status) then
        local status_error = base.validate_epistemic_status(args.epistemic_status)
        if status_error then
            table.insert(errors, status_error)
        else
            smw_properties["Has epistemic status"] = base.normalize_string(args.epistemic_status)
        end
    else
        smw_properties["Has epistemic status"] = "Working"  -- Default
    end
    
    -- Confidence validation
    if not base.is_empty(args.confidence) then
        local conf_error = base.validate_confidence(args.confidence)
        if conf_error then
            table.insert(errors, conf_error)
        else
            smw_properties["Has confidence level"] = string.format("%.2f", tonumber(args.confidence))
        end
    else
        smw_properties["Has confidence level"] = "Low"  -- Default
    end
    
    -- Evidence type validation
    if not base.is_empty(args.evidence) then
        local evidence_error = base.validate_evidence_type(args.evidence)
        if evidence_error then
            table.insert(errors, evidence_error)
        else
            smw_properties["Has evidence type"] = base.normalize_string(args.evidence)
        end
    else
        smw_properties["Has evidence type"] = "Secondary"  -- Default
    end
    
    -- Verification state validation
    if not base.is_empty(args.verification) then
        local verif_error = base.validate_verification_state(args.verification)
        if verif_error then
            table.insert(errors, verif_error)
        else
            smw_properties["Has verification state"] = base.normalize_string(args.verification)
        end
    else
        smw_properties["Has verification state"] = "Pending"  -- Default
    end
    
    -- Depth validation
    if not base.is_empty(args.depth) then
        local depth_error = base.validate_comment_depth(args.depth)
        if depth_error then
            table.insert(errors, depth_error)
        else
            smw_properties["Has comment depth"] = tostring(tonumber(args.depth))
        end
    else
        smw_properties["Has comment depth"] = "1"  -- Default
    end
    
    -- Author and date
    if not base.is_empty(args.author) then
        smw_properties["Has comment author"] = "[[User:" .. args.author .. "]]"
    end
    
    if not base.is_empty(args.date) then
        smw_properties["Has comment date"] = args.date
    end
    
    -- Parent comment
    if not base.is_empty(args.parent) then
        smw_properties["Has parent comment"] = "[[" .. args.parent .. "]]"
    end
    
    -- Stream ID
    smw_properties["Has stream id"] = args.stream_id or "default"
    
    -- Generate output
    local output = ""
    if #errors > 0 then
        output = output .. base.generate_error_html(errors)
    else
        output = output .. base.generate_smw_set(smw_properties)
    end
    
    return output
end

function p.main(frame)
    return p.validate(frame)
end

return p
```

