== 2. Module:ValidatorBase ==

=== 2.1 Base Module Specification ===

```lua
-- Module:ValidatorBase
-- Foundation module for all BITwiki template validation
-- Dependencies: None (pure Lua)

local p = {}

-- Configuration tables
local CONFIG = {
    EPHEMERAL_KEYWORDS = {"temporary", "draft", "wip", "test"},
    VALID_EPISTEMIC_STATUSES = {
        ["Established"] = true,
        ["Attribution-Traced"] = true,
        ["Working"] = true,
        ["Speculative"] = true,
        ["Disputed"] = true
    },
    VALID_EVIDENCE_TYPES = {
        ["Primary"] = true,
        ["Secondary"] = true,
        ["Tertiary"] = true,
        ["Anecdotal"] = true,
        ["None"] = true
    },
    VALID_VERIFICATION_STATES = {
        ["Verified"] = true,
        ["Pending"] = true,
        ["Challenged"] = true,
        ["Refuted"] = true,
        ["Superseded"] = true
    },
    VALID_COMMENT_TYPES = {
        ["Question"] = true,
        ["Claim"] = true,
        ["Evidence"] = true,
        ["Synthesis"] = true,
        ["Meta"] = true
    },
    CONFIDENCE_MIN = 0.0,
    CONFIDENCE_MAX = 1.0,
    MAX_COMMENT_DEPTH = 5
}

-- Utility Functions

function p.is_empty(value)
    if value == nil then return true end
    if type(value) == "string" then
        return value:match("^%s*$") ~= nil
    end
    return false
end

function p.normalize_string(value)
    if type(value) ~= "string" then return nil end
    return value:match("^%s*(.-)%s*$")
end

function p.validate_required(args, required_params)
    local errors = {}
    for _, param in ipairs(required_params) do
        if p.is_empty(args[param]) then
            table.insert(errors, string.format("Required parameter '%s' is missing or empty", param))
        end
    end
    return errors
end

function p.validate_numeric_range(value, min, max, param_name)
    local num = tonumber(value)
    if num == nil then
        return string.format("Parameter '%s' must be numeric, got '%s'", param_name, tostring(value))
    end
    if num < min or num > max then
        return string.format("Parameter '%s' must be between %.1f and %.1f, got %.2f", 
            param_name, min, max, num)
    end
    return nil
end

function p.validate_controlled_vocab(value, valid_values, param_name)
    local normalized = p.normalize_string(value)
    if normalized == nil then
        return string.format("Parameter '%s' is required", param_name)
    end
    if not valid_values[normalized] then
        local valid_list = {}
        for k, _ in pairs(valid_values) do
            table.insert(valid_list, k)
        end
        table.sort(valid_list)
        return string.format("Parameter '%s' must be one of: %s, got '%s'",
            param_name, table.concat(valid_list, ", "), normalized)
    end
    return nil
end

function p.validate_confidence(value)
    return p.validate_numeric_range(value, CONFIG.CONFIDENCE_MIN, CONFIG.CONFIDENCE_MAX, "confidence")
end

function p.validate_epistemic_status(value)
    return p.validate_controlled_vocab(value, CONFIG.VALID_EPISTEMIC_STATUSES, "epistemic_status")
end

function p.validate_evidence_type(value)
    return p.validate_controlled_vocab(value, CONFIG.VALID_EVIDENCE_TYPES, "evidence_type")
end

function p.validate_verification_state(value)
    return p.validate_controlled_vocab(value, CONFIG.VALID_VERIFICATION_STATES, "verification")
end

function p.validate_comment_type(value)
    return p.validate_controlled_vocab(value, CONFIG.VALID_COMMENT_TYPES, "type")
end

function p.validate_comment_depth(value)
    local error_msg = p.validate_numeric_range(value, 1, CONFIG.MAX_COMMENT_DEPTH, "depth")
    if error_msg then return error_msg end
    return nil
end

function p.generate_smw_set(properties)
    local parts = {}
    for key, value in pairs(properties) do
        if not p.is_empty(value) then
            table.insert(parts, string.format("%s=%s", key, value))
        end
    end
    if #parts == 0 then return "" end
    return "{{#set:" .. table.concat(parts, "|") .. "}}"
end

function p.generate_error_html(errors)
    if #errors == 0 then return "" end
    local html = '<div class="bitwiki-validation-errors">'
    html = html .. '<strong>Template Validation Errors:</strong><ul>'
    for _, error in ipairs(errors) do
        html = html .. '<li>' .. error .. '</li>'
    end
    html = html .. '</ul></div>'
    return html
end

return p
```

