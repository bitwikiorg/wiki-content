'''Lua Output:'''
```lua
local TIER_CLASSES = {
    Established = "bitwiki-epistemic-established",
    Developing = "bitwiki-epistemic-developing",
    Preliminary = "bitwiki-epistemic-preliminary",
    Speculative = "bitwiki-epistemic-speculative"
}

function p.tier(frame)
    local tier = frame.args.tier
    if not TIER_CLASSES[tier] then
        return '<span class="bitwiki-epistemic-error">Invalid tier</span>'
    end
    local html = '<span class="bitwiki-epistemic-badge ' .. TIER_CLASSES[tier] .. '">' .. tier .. '</span>'
    if frame.args.definition then
        html = html .. '<br/><small>' .. frame.args.definition .. '</small>'
    end
    return html
end
```

