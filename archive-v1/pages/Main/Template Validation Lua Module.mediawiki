== 4. Module:InfoboxValidator ==

=== 4.1 Infobox Validation Module ===

```lua
-- Module:InfoboxValidator
-- Validates Infobox_Concept_Improved template parameters
-- Dependencies: Module:ValidatorBase

local p = {}
local base = require("Module:ValidatorBase")

function p.validate(frame)
    local args = frame.args
    local errors = {}
    local smw_properties = {}
    
    -- Required fields
    local required = {"title", "definition", "domain", "epistemic_status", "confidence"}
    local required_errors = base.validate_required(args, required)
    for _, err in ipairs(required_errors) do
        table.insert(errors, err)
    end
    
    -- Title validation
    if not base.is_empty(args.title) then
        if #args.title > 200 then
            table.insert(errors, "Title exceeds 200 character limit")
        else
            smw_properties["Has concept title"] = args.title
        end
    end
    
    -- Definition validation
    if not base.is_empty(args.definition) then
        if #args.definition < 10 then
            table.insert(errors, "Definition must be at least 10 characters")
        elseif #args.definition > 2000 then
            table.insert(errors, "Definition exceeds 2000 character limit")
        else
            smw_properties["Has concept definition"] = args.definition
        end
    end
    
    -- Domain validation
    if not base.is_empty(args.domain) then
        smw_properties["Has knowledge domain"] = args.domain
    end
    
    -- Epistemic validation
    if not base.is_empty(args.epistemic_status) then
        local status_error = base.validate_epistemic_status(args.epistemic_status)
        if status_error then
            table.insert(errors, status_error)
        else
            smw_properties["Has epistemic status"] = base.normalize_string(args.epistemic_status)
        end
    end
    
    -- Confidence validation
    if not base.is_empty(args.confidence) then
        local conf_error = base.validate_confidence(args.confidence)
        if conf_error then
            table.insert(errors, conf_error)
        else
            smw_properties["Has confidence level"] = string.format("%.2f", tonumber(args.confidence))
        end
    end
    
    -- Evidence type validation
    if not base.is_empty(args.evidence_type) then
        local evidence_error = base.validate_evidence_type(args.evidence_type)
        if evidence_error then
            table.insert(errors, evidence_error)
        else
            smw_properties["Has evidence type"] = base.normalize_string(args.evidence_type)
        end
    end
    
    -- Sources validation
    if not base.is_empty(args.sources) then
        local sources_num = tonumber(args.sources)
        if sources_num and sources_num >= 0 then
            smw_properties["Has source count"] = tostring(sources_num)
        end
    end
    
    -- Template metadata
    smw_properties["Has template source"] = "Infobox_Concept_Improved"
    smw_properties["Has validation tier"] = "L3"
    
    -- Generate output
    local output = ""
    if #errors > 0 then
        output = output .. base.generate_error_html(errors)
    else
        output = output .. base.generate_smw_set(smw_properties)
    end
    
    return output
end

function p.main(frame)
    return p.validate(frame)
end

return p
```

