== 6. Interaction Design

=== 6.1 Filtering Controls

'''Epistemic Status Filter:'''
```javascript
const statusFilter = d3.select("#controls")
  .append("select")
  .on("change", function() {
    const selected = this.value;
    node.style("display", d => 
      selected === "all" || d.epistemicStatus === selected ? "block" : "none");
  });

statusFilter.selectAll("option")
  .data(["all", "Axiomatic", "Established", "Emerging", "Hypothetical", "Contested"])
  .enter().append("option")
  .attr("value", d => d)
  .text(d => d);
```

'''Confidence Threshold Slider:'''
```javascript
const confidenceSlider = d3.select("#controls")
  .append("input")
  .attr("type", "range")
  .attr("min", 0)
  .attr("max", 1)
  .attr("step", 0.1)
  .on("input", function() {
    const threshold = parseFloat(this.value);
    node.style("opacity", d => d.confidence >= threshold ? 1 : 0.2);
  });
```

=== 6.2 Node Details on Hover

```javascript
node.on("mouseover", function(event, d) {
  const tooltip = d3.select("#tooltip");
  tooltip.style("visibility", "visible")
    .html(`
      <strong>${d.label}</strong><br/>
      Status: ${d.epistemicStatus}<br/>
      Confidence: ${d.confidence}<br/>
      Domain: ${d.domain}
    `)
    .style("left", (event.pageX + 10) + "px")
    .style("top", (event.pageY + 10) + "px");
});
```

=== 6.3 Path Highlighting

```javascript
function highlightPath(sourceId, targetId) {
  // Find shortest path using Dijkstra's algorithm
  const path = findShortestPath(graph, sourceId, targetId);
  
  // Highlight path edges
  link.attr("stroke", d => 
    path.includes(d) ? "#FF0000" : "#999");
  
  // Highlight path nodes
  node.attr("stroke", d => 
    path.nodes.includes(d.id) ? "#FF0000" : "none");
}
```

